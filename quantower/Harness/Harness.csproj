<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs ../Core/RangeCore.cs (the exact file compiled into the Quantower indicator) on the NinjaTrader
       1-minute file and writes every session's inputs and forecast, for compare_core.py. No Quantower DLL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\RangeCore.cs" Link="RangeCore.cs" />
  </ItemGroup>

</Project>
